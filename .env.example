# Copy to .env and adjust. Never commit .env.
# Local PostgreSQL via Unix socket + peer auth (no password):
DATABASE_URL=postgresql:///tab?host=/var/run/postgresql
# Database used by `npm test` (it is wiped between tests):
TEST_DATABASE_URL=postgresql:///tab_test?host=/var/run/postgresql
# Set to true for hosted databases that require SSL (e.g. Render external URL):
DATABASE_SSL=false
PORT=3001
# Stellar Testnet Network Configuration
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
